# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Environment variables & secrets
.env
.env.*
*.env

# Operating system metadata
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db

# Runtime log files (keep directory via .gitkeep)
logs/*
!logs/.gitkeep

# Generated reports and incident exports (keep directory via .gitkeep)
reports/*
!reports/.gitkeep

# Testing and coverage artifacts
.pytest_cache/
.coverage
htmlcov/

# Editor and IDE configurations
.vscode/
.idea/
*.swp
*.swo
*~
